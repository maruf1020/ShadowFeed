# Copy this file to .env.local for local development.

# Cloudflare R2
# Use the S3 credentials created for the shadowfeed bucket.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=shadowfeed
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# Optional Neon Auth / Data API values
NEON_AUTH_URL="https://your-project.neonauth.region.aws.neon.tech/neondb/auth"
NEON_JWKS_URL="https://your-project.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_API_URL="https://your-project.apirest.region.aws.neon.tech/neondb/rest/v1"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public app config
NEXT_PUBLIC_APP_NAME="ShadowFeed"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeded local demo profiles from prisma/seed.ts
# Default member: ghoststack / ghoststack@echologyx.com
# Admin profile: rootkernel / rootkernel@echologyx.com
SEED_DEFAULT_PASSWORD="ShadowFeed!2026"
SEED_ADMIN_PASSWORD="ShadowFeedAdmin!2026"

# Optional external media keys
# Configure at least one provider if you want GIF search in the composer.
GIPHY_API_KEY=""
TENOR_API_KEY=""
